meta {
  name: QueryTenants
  type: http
  seq: 3
}

get {
  url: {{baseURL}}tenants?result=Items&status=Active&orderBy=created&select=identifier&top=2
  body: none
  auth: inherit
}

query {
  result: Items
  status: Active
  orderBy: created
  select: identifier
  skip: 
  top: 2
  ~filter: identifier eq 'FranGroup'
}
