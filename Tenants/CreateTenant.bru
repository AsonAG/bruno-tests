meta {
  name: CreateTenant
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants
  body: json
  auth: none
}

body:json {
  {
    "identifier": "BruTest-{{runId}}",
    "culture": "de-CH"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdTenantId", res.getBody().id);
    console.log("createdTenantId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
