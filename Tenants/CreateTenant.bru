meta {
  name: CreateTenant
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants
  body: json
  auth: none
}

body:json {
  {
    "identifier": "BruTest-{{lauf}}",
    "culture": "de-CH"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setEnvVar("neuTenantId", res.getBody().id);
    bru.setVar("neuTenantId", res.getBody().id);
    console.log("neuTenantId = " + res.getBody().id);
  }
}
