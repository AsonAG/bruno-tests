meta {
  name: UpdatePayrollWageTypes
  type: http
  seq: 4
}

patch {
  url: {{baseURL}}v2/tenants/{{tenantId}}/payrolls/{{testPayrollId}}/wagetypes
  body: json
  auth: inherit
}

body:json {
  [
    {
      "wageTypeNumber": {{copiedWageType}},
      "nameLocalizations": { "en": "Bru copy (changed)", "de": "Bru Kopie (geändert)", "fr": "Copie Bru (modifiée)", "it": "Copia Bru (modificata)" }
    }
  ]
}

script:pre-request {
  // the wage type CopyWageType created - only a copy can be renamed, e.g. the localizations of 1000 cannot be changed
  const base = bru.interpolate("{{baseURL}}").replace(/\/+$/, "");
  const headers = { Authorization: "Bearer " + bru.getOauth2CredentialVar("$oauth2.credentials.access_token") };
  const call = async (method, path, data) => {
    try {
      return await bru.sendRequest({ method, url: base + "/" + path, headers, data, timeout: 60000 });
    } catch (e) {
      return e && e.response ? e.response : { status: 0 };
    }
  };
  const res = await call("GET", "v2/tenants/" + bru.getVar("tenantId") + "/payrolls/" + bru.getVar("testPayrollId") + "/wagetypes");
  const list = res.status < 300 && Array.isArray(res.data) ? res.data : [];
  const copy = list.find((x) => x.nameLocalizations && x.nameLocalizations.en === "Bru copy");
  if (copy) {
    bru.setVar("copiedWageType", copy.wageTypeNumber);
  } else {
    console.log("skipped: no copied wage type - CopyWageType did not run");
    bru.runner.skipRequest();
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
