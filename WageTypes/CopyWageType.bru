meta {
  name: CopyWageType
  type: http
  seq: 1
}

post {
  url: {{baseURL}}v2/tenants/{{tenantId}}/payrolls/{{createdPayrollId}}/wagetypes?copyFromWageTypeNumber={{copyableWageType}}
  body: json
  auth: none
}

query {
  copyFromWageTypeNumber: {{copyableWageType}}
}

body:json {
  {
    "en": "Bru copy",
    "de": "Bru Kopie",
    "fr": "Copie Bru",
    "it": "Copia Bru"
  }
}

script:pre-request {
  // only a wage type with isCopyable can be copied
  const { client } = require("./lib/api.js");
  bru.setVar("copyableWageType", 1000);
  try {
    const wageTypes = await client(bru).get("v2/tenants/" + bru.getVar("tenantId") + "/payrolls/" + bru.getVar("createdPayrollId") + "/wagetypes", 60000);
    const copyable = (wageTypes || []).find((x) => x.isCopyable);
    if (copyable) { bru.setVar("copyableWageType", copyable.wageTypeNumber); }
    else { console.log("no copyable wage type"); }
  } catch (e) {
    console.log("wage types could not be read: " + e.message);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
