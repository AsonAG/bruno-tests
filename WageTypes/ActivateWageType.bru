meta {
  name: ActivateWageType
  type: http
  seq: 2
}

post {
  url: {{baseURL}}v2/tenants/{{tenantId}}/payrolls/{{neuPayrollId}}/wagetypes/{{inaktiveLohnart}}:activate
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  // aktivieren geht nur bei einer noch inaktiven Lohnart, darum zur Laufzeit suchen
  const axios = require("axios");
  const https = require("https");
  const agent = new https.Agent({ rejectUnauthorized: false });
  const basis = (bru.getEnvVar("baseURL") || "").replace(/\/+$/, "");
  bru.setVar("inaktiveLohnart", bru.getEnvVar("wageTypeNumber") || 1001);
  try {
    const r = await axios.get(basis + "/v2/tenants/" + bru.getVar("tenantId") +
      "/payrolls/" + bru.getEnvVar("neuPayrollId") + "/wagetypes",
      { httpsAgent: agent, timeout: 60000 });
    const w = (r.data || []).find(x => !x.isActive);
    if (w) { bru.setVar("inaktiveLohnart", w.wageTypeNumber); }
    else { console.log("alle Lohnarten sind bereits aktiv"); }
  } catch (e) { console.log("Lohnarten nicht lesbar: " + e.message); }
}
