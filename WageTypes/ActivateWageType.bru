meta {
  name: ActivateWageType
  type: http
  seq: 2
}

post {
  url: {{baseURL}}v2/tenants/{{tenantId}}/payrolls/{{testPayrollId}}/wagetypes/{{inactiveWageType}}:activate
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  // only a wage type that is not active yet can be activated - looked up at run time
  const { client } = require("./lib/api.js");
  bru.setVar("inactiveWageType", bru.getEnvVar("wageTypeNumber") || 1001);
  try {
    const wageTypes = await client(bru).get("v2/tenants/" + bru.getVar("tenantId") + "/payrolls/" + bru.getVar("testPayrollId") + "/wagetypes", 60000);
    const inactive = (wageTypes || []).find((x) => !x.isActive);
    if (inactive) { bru.setVar("inactiveWageType", inactive.wageTypeNumber); }
    else { console.log("all wage types are active already"); }
  } catch (e) {
    console.log("wage types could not be read: " + e.message);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
