meta {
  name: 5 Add an Employee
  type: http
  seq: 5
}

post {
  url: {{baseURL}}tenants/{{qsTenantId}}/employees
  body: json
  auth: inherit
}

body:json {
  {
    "identifier": "Allen.Page@example.com",
    "firstName": "Allen",
    "lastName": "Page",
    "language": "German",
    "divisions": [
      "{{qsDivisionId}}"
    ],
    "culture": "de-ch"
  }
}

script:pre-request {
  // a second run: the employee is there already - it is used, not created again
  const base = bru.interpolate("{{baseURL}}").replace(/\/+$/, "");
  const headers = { Authorization: "Bearer " + bru.getOauth2CredentialVar("$oauth2.credentials.access_token") };
  const call = async (method, path, data) => {
    try {
      return await bru.sendRequest({ method, url: base + "/" + path, headers, data, timeout: 60000 });
    } catch (e) {
      return e && e.response ? e.response : { status: 0 };
    }
  };
  const list = (r) => (r.status < 300 && r.data ? (Array.isArray(r.data) ? r.data : r.data.items || []) : []);
  const identifier = (req.getBody() || {}).identifier || "Allen.Page@example.com";
  const existing = list(await call("GET", "tenants/" + bru.getVar("qsTenantId") + "/employees")).find((x) => x.identifier === identifier);
  if (existing) {
    bru.setVar("qsEmployeeId", existing.id);
    console.log("employee " + identifier + " exists already - used");
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) bru.setVar("qsEmployeeId", res.getBody().id);
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}

docs {
  The employee Allen Page in the division of the payroll.
}
