auth {
  mode: bearer
}

auth:bearer {
  token: {{process.env.ASON_ACCESS_TOKEN}}
}

script:pre-request {
  // Every request sends the access token ASON_ACCESS_TOKEN of the file .env (see .env.sample) - without it the run stops.
  // Resolves the ids once per run from the server. Set in the environment (sandbox, production):
  //   baseURL            address of the API
  //   tenantIdentifier   tenant the requests run against
  const { accessToken } = require("./lib/api.js");
  if (!accessToken(bru)) {
    bru.runner.stopExecution();
    throw new Error("ASON_ACCESS_TOKEN missing: copy .env.sample to .env and set your access token (see README.md)");
  }

  // The flag is set only once everything is resolved - otherwise a request started in parallel would already see it
  // and run with empty ids.
  async function resolveIds() {
    if (!bru.getVar("runId")) {
      bru.setVar("runId", String(Date.now()));
    }

    const { client, items } = require("./lib/api.js");
    const api = client(bru);
    const tenantIdentifier = bru.getEnvVar("tenantIdentifier");

    // a list from the API - empty if it cannot be read (404: nothing there)
    async function list(path) {
      try {
        return items(await api.get(path));
      } catch (e) {
        const status = e && e.response ? e.response.status : 0;
        if (status !== 404) {
          console.log(`could not read ${path}: ${e && e.message ? e.message : String(e)}`);
        }
        return [];
      }
    }
    async function firstId(path) {
      const l = await list(path);
      return l.length && l[0].id ? l[0].id : null;
    }
    function setIfFound(name, value) {
      if (value) bru.setVar(name, value);
    }

    // Always the tenant of the environment - the throwaway tenant created by Tenants is empty and must not be used here.
    const tenants = await list("tenants");
    const tenant = tenants.find((x) => x.identifier === tenantIdentifier);
    if (!tenant) {
      bru.runner.stopExecution();
      throw new Error(`tenant "${tenantIdentifier}" not found at ${api.base} - check tenantIdentifier in the environment and the access token`);
    }
    const tenantId = tenant.id;
    setIfFound("tenantId", tenantId);

    setIfFound("payrollId", await firstId(`tenants/${tenantId}/payrolls?top=1`));
    setIfFound("divisionId", await firstId(`tenants/${tenantId}/divisions?top=1`));
    setIfFound("employeeId", await firstId(`tenants/${tenantId}/employees?top=1`));
    setIfFound("userId", await firstId("users?top=1"));
    setIfFound("webhookId", await firstId(`tenants/${tenantId}/webhooks?top=1`));

    const payrollId = bru.getVar("payrollId");
    if (payrollId) {
      setIfFound("payrunPeriodId", await firstId(`tenants/${tenantId}/payrolls/${payrollId}/payrunperiods?top=1`));
      setIfFound("taskId", await firstId(`tenants/${tenantId}/payrolls/${payrollId}/tasks?top=1`));
      const periodId = bru.getVar("payrunPeriodId");
      if (periodId) {
        const periodPath = `tenants/${tenantId}/payrolls/${payrollId}/payrunperiods/${periodId}`;
        setIfFound("payoutId", await firstId(`${periodPath}/payouts?top=1`));
        setIfFound("documentId", await firstId(`${periodPath}/documents?top=1`));
        setIfFound("payrunPeriodEntryId", await firstId(`${periodPath}/entries?top=1`));
      }
      setIfFound("reportId", await firstId(`tenants/${tenantId}/payrolls/${payrollId}/reports?top=1`));
    }

    // case values: company and employee each need their own
    const companyValues = await list(`tenants/${tenantId}/companycases/changes/values?top=1`);
    if (companyValues.length) {
      setIfFound("companyCaseChangeId", companyValues[0].caseChangeId);
      setIfFound("caseValueId", companyValues[0].id);
    }
    const employeeId = bru.getVar("employeeId");
    if (employeeId) {
      const employeeValues = await list(`tenants/${tenantId}/employees/${employeeId}/cases/changes/values?top=1`);
      if (employeeValues.length) {
        setIfFound("employeeCaseChangeId", employeeValues[0].caseChangeId);
        setIfFound("employeeCaseValueId", employeeValues[0].id);
      }
    }

    bru.setVar("__idsResolved", true);
    console.log(`ids resolved for tenant ${tenantId}`);
  }
  if (!bru.getVar("__idsResolved")) {
    await resolveIds();
  }
  
  // A request for an object the database does not have (no payout, document, task... in the tenant) is skipped - with
  // the placeholder id from the environment the server would answer 500 instead of 404 (finding in the backend).
  const RESOLVED = ["tenantId", "payrollId", "divisionId", "employeeId", "userId", "webhookId", "payrunPeriodId", "taskId", "payoutId",
    "documentId", "payrunPeriodEntryId", "reportId", "companyCaseChangeId", "caseValueId", "employeeCaseChangeId", "employeeCaseValueId",
    "attachmentId", "employeeCaseDocumentId"];
  const EMPTY_ID = "00000000-0000-0000-0000-000000000000";
  // the URL with its variables: as written ({{taskId}}) or already filled in
  const url = String(req.getUrl());
  const used = [...url.matchAll(/\{\{(\w+)\}\}/g)].map((m) => m[1]).filter((name) => RESOLVED.includes(name));
  const missing = used.filter((name) => {
    const value = bru.getVar(name) || bru.getEnvVar(name);
    return !value || value === EMPTY_ID;
  });
  if (missing.length || url.includes(EMPTY_ID)) {
    console.log(`skipped: ${missing.length ? `no ${missing.join(", ")}` : "an id of the request"} in the database`);
    bru.runner.skipRequest();
  }
}

tests {
  // every request: the server must not fail - a 404 for an object the database does not have is fine, a 5xx is not
  test("no server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  # Ason Payroll Integration API - Bruno tests

  One request per endpoint of the Integration API (/swagger/Integration/swagger.json), one folder per tag.

  The environment `api` only needs the address of the API and the tenant; the collection resolves all other ids
  from the server on the first request. Requests that create an object remember its id, the matching update and
  delete use exactly that one - after a full run the database is as before.

  Run everything: `npm test` (see README.md).
}
