meta {
  name: getUsers
  type: http
  seq: 3
}

get {
  url: {{baseURL}}users?result=Items&status=Active&orderBy=created&select=firstName&top=2
  body: none
  auth: none
}

query {
  result: Items
  status: Active
  orderBy: created
  select: firstName
  skip: 
  top: 2
  filter: lastName eq 'Hoelzlberger'
}
