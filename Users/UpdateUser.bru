meta {
  name: UpdateUser
  type: http
  seq: 5
}

put {
  url: {{baseURL}}users/{{createdUserId}}
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{createdUserId}}",
    "identifier": "brutest-{{runId}}@example.org",
    "firstName": "BruChanged",
    "lastName": "Test",
    "culture": "de-CH",
    "language": "German"
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
