meta {
  name: CreateUser
  type: http
  seq: 1
}

post {
  url: {{baseURL}}users
  body: json
  auth: inherit
}

body:json {
  {
    "identifier": "brutest-{{runId}}@example.org",
    "firstName": "Bru",
    "lastName": "Test",
    "culture": "de-CH",
    "language": "German"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdUserId", res.getBody().id);
    console.log("createdUserId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
