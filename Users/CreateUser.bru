meta {
  name: CreateUser
  type: http
  seq: 1
}

post {
  url: {{baseURL}}users
  body: json
  auth: none
}

body:json {
  {
    "identifier": "brutest-{{lauf}}@example.org",
    "firstName": "Bru",
    "lastName": "Test",
    "culture": "de-CH",
    "language": "German"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("neuUserId", res.getBody().id);
    console.log("neuUserId = " + res.getBody().id);
  }
}
