meta {
  name: ClosePayrunPeriod
  type: http
  seq: 3
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{neuPayrollId}}/payrunperiods/{{testPeriodeId}}/close
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  // die eigene Periode der Test-Payroll holen, damit nichts an der echten Lohnperiode geaendert wird
  const axios = require("axios");
  const https = require("https");
  const agent = new https.Agent({ rejectUnauthorized: false });
  const basis = (bru.getEnvVar("baseURL") || "").replace(/\/+$/, "");
  try {
    const r = await axios.get(basis + "/tenants/" + bru.getVar("tenantId") +
      "/payrolls/" + bru.getEnvVar("neuPayrollId") + "/payrunperiods?top=1",
      { httpsAgent: agent, timeout: 60000 });
    const l = r.data && r.data.items ? r.data.items : r.data;
    if (l && l.length) { bru.setVar("testPeriodeId", l[0].id); }
  } catch (e) { console.log("Testperiode nicht lesbar: " + e.message); }
}
