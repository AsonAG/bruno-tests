meta {
  name: ClosePayrunPeriod
  type: http
  seq: 3
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{testPayrollId}}/payrunperiods/{{testPeriodId}}/close
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  // the period of the test payroll - so nothing changes on a real pay period
  const { loadTestPeriod } = require("./lib/api.js");
  await loadTestPeriod(bru);
}

tests {
  // the test payroll never ran a payrun: no documents of the period, so it cannot be closed
  test("period without documents: 400 Payrun period documents are not generated", function () {
    expect(res.getStatus()).to.equal(400);
    expect(JSON.stringify(res.getBody())).to.contain("Payrun period documents are not generated");
  });
}

docs {
  A period can only be closed once its documents are generated. The test payroll never ran a payrun, so the API answers
  400 "Payrun period documents are not generated" - the test checks exactly that.
}
