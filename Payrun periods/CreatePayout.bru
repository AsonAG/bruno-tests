meta {
  name: CreatePayout
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{createdPayrollId}}/payrunperiods/{{testPeriodId}}/payouts
  body: json
  auth: inherit
}

body:json {
  {
    "valueDate": "2026-01-25T00:00:00Z",
    "accountIban": "CH9300762011623852957",
    "payouts": []
  }
}

script:pre-request {
  // the period of the test payroll - so nothing changes on a real pay period
  const { ensureTestPayroll, loadTestPeriod } = require("./lib/api.js");
  await ensureTestPayroll(bru);
  await loadTestPeriod(bru);
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdPayoutId", res.getBody().id);
    console.log("createdPayoutId = " + res.getBody().id);
  }
}

docs {
  The test payroll never ran a payrun, so its period has no entries to pay out: the API answers
  400 "Payout without entries". With a tenant that ran a payrun the payout is created and CancelPayout cancels it.
}
