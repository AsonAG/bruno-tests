meta {
  name: CreatePayout
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{testPayrollId}}/payrunperiods/{{testPeriodId}}/payouts
  body: json
  auth: inherit
}

body:json {
  {
    "valueDate": "2026-01-25T00:00:00Z",
    "accountIban": "CH9300762011623852957",
    "payouts": []
  }
}

script:pre-request {
  // the period of the test payroll - so nothing changes on a real pay period
  const { loadTestPeriod } = require("./lib/api.js");
  await loadTestPeriod(bru);
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdPayoutId", res.getBody().id);
    console.log("createdPayoutId = " + res.getBody().id);
  }
}

tests {
  // the test payroll never ran a payrun: its period has no entries to pay out
  test("period without payrun: 400 Payout without entries", function () {
    expect(res.getStatus()).to.equal(400);
    expect(JSON.stringify(res.getBody())).to.contain("Payout without entries");
  });
}

docs {
  The test payroll never ran a payrun, so its period has no entries to pay out: the API answers
  400 "Payout without entries" - the test checks exactly that. CancelPayout is skipped then.
}
