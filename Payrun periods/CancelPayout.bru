meta {
  name: CancelPayout
  type: http
  seq: 2
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{testPayrollId}}/payrunperiods/{{testPeriodId}}/payouts/{{createdPayoutId}}
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  // only a payout CreatePayout created can be cancelled
  if (!bru.getVar("createdPayoutId")) {
    console.log("skipped: CreatePayout created no payout");
    bru.runner.skipRequest();
  }
}
