meta {
  name: CancelPayout
  type: http
  seq: 2
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{createdPayrollId}}/payrunperiods/{{testPeriodId}}/payouts/{{createdPayoutId}}
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  // only a payout CreatePayout created can be cancelled
  if (!bru.getVar("createdPayoutId")) {
    console.log("skipped: CreatePayout created no payout");
    bru.runner.skipRequest();
    return;
  }
  // the period of the test payroll - so nothing changes on a real pay period
  const { ensureTestPayroll, loadTestPeriod } = require("./lib/api.js");
  await ensureTestPayroll(bru);
  await loadTestPeriod(bru);
}
