meta {
  name: CreateEmployee
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/employees
  body: json
  auth: inherit
}

body:json {
  {
    "identifier": "brutest-{{runId}}@example.org",
    "firstName": "Bru",
    "lastName": "Test",
    "language": "German",
    "divisions": ["{{testDivisionId}}"],
    "culture": "de-CH"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdEmployeeId", res.getBody().id);
    console.log("createdEmployeeId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
