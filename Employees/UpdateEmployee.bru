meta {
  name: UpdateEmployee
  type: http
  seq: 4
}

put {
  url: {{baseURL}}tenants/{{tenantId}}/employees/{{createdEmployeeId}}
  body: json
  auth: none
}

body:json {
  {
    "id": "{{createdEmployeeId}}",
    "identifier": "brutest-{{runId}}@example.org",
    "firstName": "BruChanged",
    "lastName": "Test",
    "language": "German",
    "divisions": ["{{divisionId}}"],
    "culture": "de-CH"
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
