meta {
  name: UpdateTask
  type: http
  seq: 8
}

put {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{payrollId}}/tasks/{{createdTaskId}}
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{createdTaskId}}",
    "name": "BruTest-{{runId}}",
    "category": "TestChanged",
    "instruction": "Created by the Bruno collection",
    "scheduled": "2026-01-01T00:00:00Z",
    "attributes": { "{{attributeName}}": "123" }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
