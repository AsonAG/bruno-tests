meta {
  name: CreateTask
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{payrollId}}/tasks
  body: json
  auth: none
}

body:json {
  {
    "name": "BruTest-{{runId}}",
    "category": "Test",
    "instruction": "Created by the Bruno collection",
    "scheduled": "2026-01-01T00:00:00Z"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdTaskId", res.getBody().id);
    console.log("createdTaskId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
