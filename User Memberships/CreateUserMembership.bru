meta {
  name: CreateUserMembership
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/user_memberships
  body: json
  auth: inherit
}

body:json {
  {
    "tenantId": "{{tenantId}}",
    "userId": "{{memberUserId}}",
    "firstName": "Bru",
    "lastName": "Test",
    "role": { "$type": "Admin" }
  }
}

script:pre-request {
  // the membership needs a user of its own
  const base = bru.interpolate("{{baseURL}}").replace(/\/+$/, "");
  const headers = { Authorization: "Bearer " + bru.getOauth2CredentialVar("$oauth2.credentials.access_token") };
  const call = async (method, path, data) => {
    try {
      return await bru.sendRequest({ method, url: base + "/" + path, headers, data, timeout: 60000 });
    } catch (e) {
      return e && e.response ? e.response : { status: 0 };
    }
  };
  const r = await call("POST", "users", { identifier: "brumember-" + bru.getVar("runId") + "@example.org",
    firstName: "Bru", lastName: "Member", language: "German", culture: "de-CH" });
  if (r.status < 300 && r.data && r.data.id) {
    bru.setVar("memberUserId", r.data.id);
  } else {
    console.log("user for the membership could not be created: " + r.status);
    bru.setVar("memberUserId", bru.getVar("userId"));
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdMembershipId", res.getBody().id);
    console.log("createdMembershipId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
