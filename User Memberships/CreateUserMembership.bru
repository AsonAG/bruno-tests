meta {
  name: CreateUserMembership
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/user_memberships
  body: json
  auth: inherit
}

body:json {
  {
    "tenantId": "{{tenantId}}",
    "userId": "{{memberUserId}}",
    "firstName": "Bru",
    "lastName": "Test",
    "role": { "$type": "Admin" }
  }
}

script:pre-request {
  // the membership needs a user of its own
  const { client } = require("./lib/api.js");
  try {
    const user = await client(bru).post("users",
      { identifier: "brumember-" + bru.getVar("runId") + "@example.org",
        firstName: "Bru", lastName: "Member", language: "German", culture: "de-CH" }, 60000);
    bru.setVar("memberUserId", user.id);
  } catch (e) {
    console.log("user for the membership could not be created: " + e.message);
    bru.setVar("memberUserId", bru.getVar("userId"));
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdMembershipId", res.getBody().id);
    console.log("createdMembershipId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
