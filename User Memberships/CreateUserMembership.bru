meta {
  name: CreateUserMembership
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/user_memberships
  body: json
  auth: none
}

body:json {
  {
    "tenantId": "{{tenantId}}",
    "userId": "{{mitgliedUserId}}",
    "firstName": "Bru",
    "lastName": "Test",
    "role": { "$type": "Admin" }
  }
}

script:pre-request {
  // die Mitgliedschaft braucht einen eigenen Benutzer; der Ordner Users laeuft erst spaeter
  const axios = require("axios");
  const https = require("https");
  const agent = new https.Agent({ rejectUnauthorized: false });
  const basis = (bru.getEnvVar("baseURL") || "").replace(/\/+$/, "");
  try {
    const r = await axios.post(basis + "/users",
      { identifier: "brumember-" + bru.getVar("lauf") + "@example.org",
        firstName: "Bru", lastName: "Member", language: "German", culture: "de-CH" },
      { httpsAgent: agent, timeout: 60000 });
    bru.setVar("mitgliedUserId", r.data.id);
    bru.setEnvVar("mitgliedUserId", r.data.id);
  } catch (e) {
    console.log("Benutzer fuer Mitgliedschaft nicht anlegbar: " + e.message);
    bru.setVar("mitgliedUserId", bru.getVar("userId"));
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setEnvVar("neuMembershipId", res.getBody().id);
    console.log("neuMembershipId = " + res.getBody().id);
  }
}
