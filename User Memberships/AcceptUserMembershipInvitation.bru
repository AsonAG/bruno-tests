meta {
  name: AcceptUserMembershipInvitation
  type: http
  seq: 3
}

post {
  url: {{baseURL}}user_membership_invitations/{{einladungZumAnnehmen}}
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  // eine eigene Einladung anlegen; die aus InviteUser wird spaeter noch gelesen und zurueckgezogen
  const axios = require("axios");
  const https = require("https");
  const agent = new https.Agent({ rejectUnauthorized: false });
  const basis = (bru.getEnvVar("baseURL") || "").replace(/\/+$/, "");
  bru.setVar("einladungZumAnnehmen", bru.getEnvVar("invitationId"));
  try {
    const r = await axios.post(basis + "/tenants/" + bru.getVar("tenantId") + "/user_memberships/invite",
      { email: "bruaccept-" + bru.getVar("lauf") + "@example.org", role: { $type: "Admin" } },
      { httpsAgent: agent, timeout: 60000 });
    if (r.data && r.data.id) { bru.setVar("einladungZumAnnehmen", r.data.id); }
  } catch (e) { console.log("Einladung nicht anlegbar: " + e.message); }
}
