meta {
  name: AcceptUserMembershipInvitation
  type: http
  seq: 3
}

post {
  url: {{baseURL}}user_membership_invitations/{{invitationToAccept}}
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  // an invitation of its own - the one of InviteUser is read and withdrawn later
  const { client } = require("./lib/api.js");
  bru.setVar("invitationToAccept", bru.getVar("invitationId"));
  try {
    const invitation = await client(bru).post("tenants/" + bru.getVar("tenantId") + "/user_memberships/invite",
      { email: "bruaccept-" + bru.getVar("runId") + "@example.org", role: { $type: "Admin" } }, 60000);
    if (invitation && invitation.id) { bru.setVar("invitationToAccept", invitation.id); }
  } catch (e) {
    console.log("invitation could not be created: " + e.message);
  }
}

script:post-response {
  // the invitation of its own is withdrawn again - accepting does not remove it
  const id = bru.getVar("invitationToAccept");
  if (id && id !== bru.getVar("invitationId")) {
    const { client } = require("./lib/api.js");
    try {
      await client(bru).del("tenants/" + bru.getVar("tenantId") + "/user_memberships/invitations/" + id);
      console.log("invitation withdrawn: " + id);
    } catch (e) {
      console.log("invitation " + id + " could not be withdrawn: " + e.message);
    }
  }
}
