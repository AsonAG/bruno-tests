meta {
  name: AcceptUserMembershipInvitation
  type: http
  seq: 3
}

post {
  url: {{baseURL}}user_membership_invitations/{{invitationToAccept}}
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  // an invitation of its own - the one of InviteUser is read and withdrawn later
  const base = bru.interpolate("{{baseURL}}").replace(/\/+$/, "");
  const headers = { Authorization: "Bearer " + bru.getOauth2CredentialVar("$oauth2.credentials.access_token") };
  const call = async (method, path, data) => {
    try {
      return await bru.sendRequest({ method, url: base + "/" + path, headers, data, timeout: 60000 });
    } catch (e) {
      return e && e.response ? e.response : { status: 0 };
    }
  };
  bru.setVar("invitationToAccept", bru.getVar("invitationId"));
  const r = await call("POST", "tenants/" + bru.getVar("tenantId") + "/user_memberships/invite",
    { email: "bruaccept-" + bru.getVar("runId") + "@example.org", role: { $type: "Admin" } });
  if (r.status < 300 && r.data && r.data.id) bru.setVar("invitationToAccept", r.data.id);
  else console.log("invitation could not be created: " + r.status);
}

script:post-response {
  // the invitation of its own is withdrawn again - accepting does not remove it
  const id = bru.getVar("invitationToAccept");
  if (id && id !== bru.getVar("invitationId")) {
    const base = bru.interpolate("{{baseURL}}").replace(/\/+$/, "");
    const headers = { Authorization: "Bearer " + bru.getOauth2CredentialVar("$oauth2.credentials.access_token") };
    const call = async (method, path, data) => {
      try {
        return await bru.sendRequest({ method, url: base + "/" + path, headers, data, timeout: 60000 });
      } catch (e) {
        return e && e.response ? e.response : { status: 0 };
      }
    };
    const r = await call("DELETE", "tenants/" + bru.getVar("tenantId") + "/user_memberships/invitations/" + id);
    console.log(r.status < 300 ? "invitation withdrawn: " + id : "invitation " + id + " could not be withdrawn: " + r.status);
  }
}
