meta {
  name: RemoveUserMembership
  type: http
  seq: 9
}

delete {
  url: {{baseURL}}tenants/{{tenantId}}/user_memberships/{{createdMembershipId}}
  body: none
  auth: inherit
}

script:post-response {
  // the user CreateUserMembership created for the membership
  const user = bru.getVar("memberUserId");
  if (user && user !== bru.getVar("userId")) {
    const { client } = require("./lib/api.js");
    try {
      await client(bru).del("users/" + user);
      console.log("member user deleted: " + user);
    } catch (e) {
      console.log("member user " + user + " could not be deleted: " + e.message);
    }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
