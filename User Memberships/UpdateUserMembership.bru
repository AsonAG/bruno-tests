meta {
  name: UpdateUserMembership
  type: http
  seq: 7
}

put {
  url: {{baseURL}}tenants/{{tenantId}}/user_memberships/{{createdMembershipId}}
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{createdMembershipId}}",
    "tenantId": "{{tenantId}}",
    "userId": "{{createdUserId}}",
    "firstName": "BruChanged",
    "lastName": "Test",
    "role": { "$type": "Admin" }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
