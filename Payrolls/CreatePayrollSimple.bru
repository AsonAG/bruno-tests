meta {
  name: CreatePayrollSimple
  type: http
  seq: 2
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/simple
  body: json
  auth: inherit
}

body:json {
  {
    "name": "BruTestSimple-{{runId}}",
    "language": "German",
    "culture": "de-CH",
    "accountingStartDate": "2026-01-01T00:00:00Z"
  }
}

script:post-response {
  // deleted by DeletePayroll - with the division it creates for itself
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdSimplePayrollId", res.getBody().id);
    bru.setVar("createdSimpleDivisionId", res.getBody().divisionId);
    console.log("createdSimplePayrollId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
