meta {
  name: CreatePayroll
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls
  body: json
  auth: inherit
}

body:json {
  {
    "name": "BruTest-{{runId}}",
    "divisionId": "{{testDivisionId}}",
    "calendarCalculationMode": "MonthCalendarDay",
    "country": 756,
    "language": "German",
    "accountingStartDate": "2026-01-01T00:00:00Z"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdPayrollId", res.getBody().id);
    console.log("createdPayrollId = " + res.getBody().id);
    // without regulations the payroll has neither cases nor wage types
    const { client, assignRegulations } = require("./lib/api.js");
    try {
      await assignRegulations(client(bru), bru.getVar("tenantId"), res.getBody().id);
      console.log("regulation CH.Swissdec assigned");
    } catch (e) {
      console.log("regulation could not be assigned: " + e.message);
    }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
