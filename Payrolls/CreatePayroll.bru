meta {
  name: CreatePayroll
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls
  body: json
  auth: inherit
}

body:json {
  {
    "name": "BruTest-{{runId}}",
    "divisionId": "{{testDivisionId}}",
    "calendarCalculationMode": "MonthCalendarDay",
    "country": 756,
    "language": "German",
    "accountingStartDate": "2026-01-01T00:00:00Z"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdPayrollId", res.getBody().id);
    console.log("createdPayrollId = " + res.getBody().id);
    // without regulations the payroll has neither cases nor wage types
  const base = bru.interpolate("{{baseURL}}").replace(/\/+$/, "");
  const headers = { Authorization: "Bearer " + bru.getOauth2CredentialVar("$oauth2.credentials.access_token") };
  const call = async (method, path, data) => {
    try {
      return await bru.sendRequest({ method, url: base + "/" + path, headers, data, timeout: 60000 });
    } catch (e) {
      return e && e.response ? e.response : { status: 0 };
    }
  };
    const r = await call("PUT", "tenants/" + bru.getVar("tenantId") + "/payrolls/" + res.getBody().id + "/regulations", {
      countryRegulation: "CH.Swissdec", industries: [], erp: [],
      accountingDocument: "AccountingDocument1", accountingData: "CH.AccountingDataKMU",
    });
    console.log(r.status < 300 ? "regulation CH.Swissdec assigned" : "regulation could not be assigned: " + r.status);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
