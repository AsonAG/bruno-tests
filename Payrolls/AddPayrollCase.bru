meta {
  name: AddPayrollCase
  type: http
  seq: 4
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{neuPayrollId}}/cases/sets
  body: json
  auth: none
}

body:json {
  {
    "divisionId": "{{divisionId}}",
    "reason": "BruTest",
    "start": "2026-01-01T00:00:00Z",
    "case": {
      "caseName": "{{caseName}}",
      "values": [
        { "caseName": "{{caseName}}", "caseFieldName": "CH.Swissdec.CompanyAddressId", "valueType": "String", "value": "CHE-999.999.996", "start": "2026-01-01T00:00:00Z" },
        { "caseName": "{{caseName}}", "caseFieldName": "CH.Swissdec.ContactPersonName", "valueType": "String", "value": "Bru Test {{lauf}}", "start": "2026-01-01T00:00:00Z" },
        { "caseName": "{{caseName}}", "caseFieldName": "CH.Swissdec.ContactPersonEmailAddress", "valueType": "String", "value": "brutest@example.org", "start": "2026-01-01T00:00:00Z" },
        { "caseName": "{{caseName}}", "caseFieldName": "CH.Swissdec.ContactPersonPhoneNumber", "valueType": "String", "value": "+41 44 000 00 00", "start": "2026-01-01T00:00:00Z" }
      ]
    }
  }
}

script:post-response {
  // die angelegten Werte merken, damit DeleteCompanyCaseChange etwas zu loeschen hat
  const b = res.getBody();
  if (res.getStatus() < 300 && b && b.values && b.values.length) {
    bru.setVar("neuCompanyCaseChangeId", b.values[0].id);
    console.log("neuCompanyCaseChangeId = " + b.values[0].id);
  }
}
