meta {
  name: UpdatePayroll
  type: http
  seq: 31
}

put {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{neuPayrollId}}
  body: json
  auth: none
}

body:json {
  {
    "id": "{{neuPayrollId}}",
    "name": "BruTest-{{lauf}}-geaendert",
    "divisionId": "{{divisionId}}",
    "calendarCalculationMode": "MonthCalendarDay",
    "country": 756,
    "language": "German",
    "accountingStartDate": "2026-01-01T00:00:00Z"
  }
}
