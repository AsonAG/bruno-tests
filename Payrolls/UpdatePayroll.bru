meta {
  name: UpdatePayroll
  type: http
  seq: 31
}

put {
  url: {{baseURL}}tenants/{{tenantId}}/payrolls/{{createdPayrollId}}
  body: json
  auth: none
}

body:json {
  {
    "id": "{{createdPayrollId}}",
    "name": "BruTest-{{runId}}-changed",
    "divisionId": "{{divisionId}}",
    "calendarCalculationMode": "MonthCalendarDay",
    "country": 756,
    "language": "German",
    "accountingStartDate": "2026-01-01T00:00:00Z"
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
