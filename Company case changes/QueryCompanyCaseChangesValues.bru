meta {
  name: QueryCompanyCaseChangesValues
  type: http
  seq: 3
}

get {
  url: {{baseURL}}tenants/{{tenantId}}/companycases/changes/values?divisionId={{divisionId}}&excludeGlobal=true&filter=userIdentifier eq 'peter.schmid@swissdec.ch'&language=German&orderBy=caseName&result=Items&skip=1&top=5&status=Active&select=userIdentifier
  body: none
  auth: inherit
}

query {
  divisionId: 59
  excludeGlobal: true
  filter: userIdentifier eq 'peter.schmid@swissdec.ch'
  langue: German
  orderBy: caseName
  result: Items
  skip: 1
  top: 5
  status: Active
  select: userIdentifier
}
