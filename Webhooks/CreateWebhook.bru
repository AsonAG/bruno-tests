meta {
  name: CreateWebhook
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/webhooks
  body: json
  auth: inherit
}

body:json {
  {
    "payloadUrl": "https://example.org/bruno-test",
    "events": [],
    "hasSecret": false
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdWebhookId", res.getBody().id);
    console.log("createdWebhookId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
