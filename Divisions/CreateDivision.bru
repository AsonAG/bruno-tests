meta {
  name: CreateDivision
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/divisions
  body: json
  auth: none
}

body:json {
  {
    "name": "BruTest-{{lauf}}",
    "culture": "de-CH"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setEnvVar("neuDivisionId", res.getBody().id);
    console.log("neuDivisionId = " + res.getBody().id);
  }
}
