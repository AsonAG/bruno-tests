meta {
  name: CreateDivision
  type: http
  seq: 1
}

post {
  url: {{baseURL}}tenants/{{tenantId}}/divisions
  body: json
  auth: inherit
}

body:json {
  {
    "name": "BruTest-{{runId}}",
    "culture": "de-CH"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setVar("createdDivisionId", res.getBody().id);
    console.log("createdDivisionId = " + res.getBody().id);
  }
}

tests {
  test("succeeds", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
