meta {
  name: QueryDivisions
  type: http
  seq: 3
}

get {
  url: {{baseURL}}tenants/{{tenantId}}/divisions?filter=name eq 'CH.Swissdec'&orderBy=name&result=Items&status=Active&top=1&select=name
  body: none
  auth: inherit
}

query {
  filter: name eq 'CH.Swissdec'
  orderBy: name
  result: Items
  status: Active
  top: 1
  select: name
  ~skip: 1
}
